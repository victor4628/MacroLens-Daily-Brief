# ── LLM (set at least one) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6        # optional override

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat             # optional override

# ── Data APIs ─────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here   # free tier at finnhub.io
FRED_API_KEY=your_fred_api_key_here         # free at fred.stlouisfed.org/docs/api/api_key.html

# ── Telegram notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Observability (optional) ──────────────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
